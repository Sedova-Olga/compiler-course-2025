; RUN: llc -mtriple=x86_64-unknown-linux-gnu --load=%llvmshlibdir/DecomposeFMAPass_Sedova_Olga_FIIT1_BACKEND%shlibext \
; RUN: -run-pass=decompose-fma %s -o - | FileCheck %s

define void @test() {
  ; CHECK-LABEL: name: test
  ; CHECK: G_MUL
  ; CHECK: G_ADD
  ; CHECK-NOT: G_FMA
  %res = call float @llvm.fma.f32(float %a, float %b, float %c)
  ret void
}

