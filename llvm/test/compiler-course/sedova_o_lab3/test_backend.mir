# RUN: llc -mtriple x86_64-unknown-linux-gnu -mattr=+avx --load=%llvmshlibdir/DecomposeFMAPass_Sedova_Olga_FIIT1_BACKEND%shlibext \
# RUN: -run-pass=decompose-fma %s -o - | FileCheck %s

--- |
  ; ModuleID = 'test_backend.mir'
  source_filename = "test_backend.mir"
  target datalayout = "e-m:e-p:64:64-i64:64-f80:128-n8:16:32:64-S128"

  define void @test() {
    ret void
  }

...
---
# CHECK: name:            test
name:            test
alignment:       16
tracksRegLiveness: true
registers:       []
liveins:
  - { reg: '$vreg1', virtual-reg: '' }
  - { reg: '$vreg2', virtual-reg: '' }
  - { reg: '$vreg3', virtual-reg: '' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
body:             |
  bb.0:
    liveins: $vreg1, $vreg2, $vreg3

    ; CHECK-NOT: G_FMA
    ; CHECK: G_MUL
    ; CHECK: G_ADD

    G_FMA $vreg0, $vreg1, $vreg2, $vreg3

    RET
...
