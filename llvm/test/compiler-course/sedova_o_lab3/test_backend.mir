# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/FMADecomposePass_Sedova_Olga_FIIT1_BACKEND%shlibext \
# RUN: -run-pass=fma-decompose  %s -o - | FileCheck %s

// CHECK-LABEL: ; Function: @test_multiple_fma
// CHECK-NOT: G_FMA
// CHECK: G_MUL
// CHECK: G_ADD

func @test_multiple_fma() {
bb.0:
  %vreg1 = G_FMA %vreg2, %vreg3, %vreg4
  ret
}

; CHECK-LABEL: ; Function: @test_fma_different_regs
; CHECK-NOT: G_FMA
; CHECK: G_MUL
; CHECK: G_ADD

func @test_fma_different_regs() {
bb.0:
  %r1 = G_FMA %r2, %r3, %r4
  %r5 = G_FMA %r6, %r7, %r8
  ret
}

; CHECK-LABEL: ; Function: @test_no_fma
; CHECK-NOT: G_FMA
; CHECK-NOT: G_MUL
; CHECK-NOT: G_ADD

func @test_no_fma() {
bb.0:
  %r1 = G_MUL %r2, %r3
  %r4 = G_ADD %r5, %r6
  ret
}

; CHECK-LABEL: ; Function: @test_fma_extra_operands
; CHECK-NOT: G_FMA
; CHECK: G_MUL
; CHECK: G_ADD

func @test_fma_extra_operands() {
bb.0:
  %r1 = G_FMA %r2, %r3, %r4, %r5
  ret
}