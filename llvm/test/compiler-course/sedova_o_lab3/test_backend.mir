; RUN: llc -mtriple=x86_64-unknown-linux-gnu --load=%llvmshlibdir/DecomposeFMA%shlibext \
; RUN: -decompose-fma -print-machineinstrs %s | FileCheck %s

func.func @test_decompose_fma() {
bb.0:
  liveins: $vreg1, $vreg2, $vreg3, $vreg4

  ; Исходная FMA-инструкция (generic G_FMA)
  ; CHECK-NOT: G_FMA
  ; CHECK: G_MUL
  ; CHECK: G_ADD

  G_FMA $vreg0, $vreg1, $vreg2, $vreg3

  RET
}
