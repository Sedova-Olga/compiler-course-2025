# RUN: llc -mtriple x86_64-unknown-linux-gnu -mattr=+avx --load=%llvmshlibdir/DecomposeFMAPass_Sedova_Olga_FIIT1_BACKEND%shlibext \
# RUN: -run-pass=decompose-fma %s -o - | FileCheck %s

--- |
  define void @test() {
    ret void
  }
...
name:            test
alignment:       16
tracksRegLiveness: true
registers:
  - { id: 0, class: fpr32 }
  - { id: 1, class: fpr32 }
  - { id: 2, class: fpr32 }
  - { id: 3, class: fpr32 }
liveins:
  - { reg: '$xmm0' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
body: |
  bb.0:
    liveins: $xmm0

    %1:fpr32 = IMPLICIT_DEF
    %2:fpr32 = IMPLICIT_DEF
    %3:fpr32 = IMPLICIT_DEF

    ; CHECK-NOT: G_FMA
    ; CHECK: G_MUL
    ; CHECK: G_ADD

    %0:fpr32 = G_FMA %1, %2, %3
    RET64 $xmm0
...
