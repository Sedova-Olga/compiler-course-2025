# RUN: llc -mtriple x86_64-unknown-linux-gnu -mattr=+avx --load=%llvmshlibdir/DecomposeFMAPass_Sedova_Olga_FIIT1_BACKEND%shlibext \
# RUN: -run-pass=decompose-fma %s -o - | FileCheck %s

--- |
  ; ModuleID = 'test_backend.mir'
  source_filename = "test_backend.mir"
  target datalayout = "e-m:e-p:64:64-i64:64-f80:128-n8:16:32:64-S128"

  define void @test() {
    ret void
  }

...
---
# CHECK: name:            test
name:            test
alignment:       16
tracksRegLiveness: true
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
  - { id: 3, class: gr32 }
liveins:
  - { reg: '$edi' }
frameInfo:
  stackSize:       0
  adjustsStack:    false
  hasCalls:        false
body:             |
  bb.0:
    liveins: $edi

    ; CHECK-NOT: G_FMA
    ; CHECK:     G_MUL
    ; CHECK:     G_ADD

    G_FMA %0, %1, %2, %3
    RET64 $eax

...
